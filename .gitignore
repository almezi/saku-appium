# Simple Money Tracker - .gitignore
# This file specifies intentionally untracked files that Git should ignore
# Learn more about Git ignores: https://git-scm.com/docs/gitignore

# === Android Build Artifacts ===
# Android Studio generated files
directory/android/
directory/app/build/
build/

# Generated APK/AAR files
*.apk
*.aar
*.apks
*.aab

# Kotlin compiler caches
**.kotlin/
**.kotlinc/

# Generated Java/Kotlin sources
**/src/main/java_generated/
**/src/main/kotlin_generated/

# Local Gradle caches
.gradle/

# Environment files
local.properties

# === IDE & Development Environment ===
# Android Studio
*.iml
*.iws
*.ipr
.idea/

# Eclipse
.project
.classpath
.settings/

# VS Code
.vscode/

# IntelliJ IDEA Community Edition
*.iws
*.iml
*.ipr

# NetBeans
.nb
nbbuild/

# Xcode (if applicable)
*.xcworkspace
*.xcodeproj
*.xcuserdata

# === Flutter/React Native/Mobile cross-platform artifacts ===
# Flutter
flutter_*.log
*.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# === Testing & Automation Artifacts ===
# Appium test results
/test-results/
screenshots/
.*-report.html

# Test execution logs
*.log

# Temporary test files
*temp*
*test_temp*

# === Documentation & Generated Files ===
# Build documentation
*.rst
*.txt

# Generated documentation
/docs/generated/
docs/source-of-truth/

