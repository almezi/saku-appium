{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "webdriverio", "@wdio/globals/types", "@wdio/mocha-framework"],
    "outDir": "./dist"
  },
  "include": ["src/**/*.ts", "wdio.conf.ts"]
}
