{
  "name": "saku-appium",
  "version": "1.0.0",
  "description": "Appium + WebdriverIO + TypeScript E2E automation for Saku (Simple Money Tracker, Android & iOS)",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "wdio run ./wdio.conf.ts",
    "test:unit": "node --test -r ts-node/register/transpile-only \"src/*/__tests__/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run check:parity",
    "check:parity": "node scripts/check_parity.mjs",
    "test:sanity": "TEST_GREP=@sanity wdio run ./wdio.conf.ts",
    "test:regression": "TEST_GREP=@regression wdio run ./wdio.conf.ts",
    "test:integration": "TEST_GREP=@integration wdio run ./wdio.conf.ts",
    "test:sanity:ios": "TEST_GREP=@sanity wdio run ./wdio.ios.conf.ts",
    "test:regression:ios": "TEST_GREP=@regression wdio run ./wdio.ios.conf.ts",
    "test:integration:ios": "TEST_GREP=@integration wdio run ./wdio.ios.conf.ts",
    "test:emulator": "wdio run ./wdio.conf.ts",
    "test:parallel": "SAKU_PARALLEL=1 wdio run ./wdio.conf.ts",
    "test:shard": "SAKU_SHARD=1 wdio run ./wdio.conf.ts",
    "appium:server1": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} appium server --base-path=/wd/hub --port 4723",
    "appium:server2": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} appium server --base-path=/wd/hub --port 4725",
    "test:navigasi": "wdio run ./wdio.conf.ts --spec ./src/tests/navigasi/navigation.spec.ts",
    "test:ios": "wdio run ./wdio.ios.conf.ts",
    "test:navigasi:ios": "wdio run ./wdio.ios.conf.ts --spec ./src/tests/navigasi/navigation.ios.spec.ts",
    "test:tambah": "wdio run ./wdio.conf.ts --spec ./src/tests/tambah/*.spec.ts",
    "test:transaksi": "wdio run ./wdio.conf.ts --spec ./src/tests/transaksi/*.spec.ts",
    "test:ringkasan": "wdio run ./wdio.conf.ts --spec ./src/tests/ringkasan/*.spec.ts",
    "test:anggaran": "wdio run ./wdio.conf.ts --spec ./src/tests/anggaran/*.spec.ts",
    "test:anggaran:ios": "wdio run ./wdio.ios.conf.ts --spec ./src/tests/anggaran/budget.ios.spec.ts",
    "test:kategori": "wdio run ./wdio.conf.ts --spec ./src/tests/kategori/*.spec.ts",
    "test:kategori:ios": "wdio run ./wdio.ios.conf.ts --spec ./src/tests/kategori/category-management.ios.spec.ts",
    "test:backup:ios": "wdio run ./wdio.ios.conf.ts --spec ./src/tests/transaksi/backup.ios.spec.ts",
    "test:val:ios": "wdio run ./wdio.ios.conf.ts --spec ./src/tests/tambah/validation.ios.spec.ts",
    "test:amt:ios": "wdio run ./wdio.ios.conf.ts --spec ./src/tests/tambah/amount-input.ios.spec.ts",
    "test:inc:ios": "wdio run ./wdio.ios.conf.ts --spec ./src/tests/tambah/add-income.ios.spec.ts",
    "test:exp:ios": "wdio run ./wdio.ios.conf.ts --spec ./src/tests/tambah/add-expense.ios.spec.ts",
    "test:pers:ios": "wdio run ./wdio.ios.conf.ts --spec ./src/tests/app/persistence.ios.spec.ts",
    "test:rot:ios": "wdio run ./wdio.ios.conf.ts --spec ./src/tests/app/rotation.ios.spec.ts",
    "test:perf:ios": "wdio run ./wdio.ios.conf.ts --spec ./src/tests/app/performance.ios.spec.ts",
    "test:a11y:ios": "wdio run ./wdio.ios.conf.ts --spec ./src/tests/app/accessibility.ios.spec.ts",
    "test:list:ios": "wdio run ./wdio.ios.conf.ts --spec ./src/tests/transaksi/transaction-list.ios.spec.ts",
    "test:edit:ios": "wdio run ./wdio.ios.conf.ts --spec ./src/tests/transaksi/edit-transaction.ios.spec.ts",
    "wdio": "wdio run ./wdio.conf.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/junit-reporter": "^9.32.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "appium": "^3.0.0",
    "appium-uiautomator2-driver": "^8.0.0",
    "appium-xcuitest-driver": "^12.21.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "axios": "^1.20.0",
    "body-parser": "^2.4.0",
    "follow-redirects": "^1.16.1",
    "proxy-addr": "^2.0.8"
  }
}
